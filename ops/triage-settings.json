{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(journalctl:*)",
      "Bash(systemctl --user status:*)",
      "Bash(systemctl --user list-units:*)",
      "Bash(systemctl --user show:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(df:*)",
      "Bash(free:*)",
      "Bash(uptime)",
      "Bash(date:*)",
      "Bash(timedatectl:*)",
      "Bash(ping:*)"
    ],
    "deny": [
      "Write",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(systemctl --user start:*)",
      "Bash(systemctl --user stop:*)",
      "Bash(systemctl --user restart:*)",
      "Bash(systemctl --user enable:*)",
      "Bash(systemctl --user disable:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git pull:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)"
    ]
  }
}
