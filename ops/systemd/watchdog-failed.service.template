[Unit]
Description=Grid Gremlin v3 {{FLEET}} watchdog CRASHED — alert, at most one page per 30 min

[Service]
Type=oneshot
EnvironmentFile={{REPO_DIR}}/.env
# A watchdog unit failure means a crash or an UNDELIVERED page (send_telegram
# raises so state never persists over a lost page) — the fleet may be fine,
# but nobody is watching it. Rate-limited like the fleet alert: the timer
# re-fires every 5 min and would otherwise page every tick.
ExecStart=/bin/sh -c 'stamp={{REPO_DIR}}/logs/{{FLEET}}-watchdog-failed.stamp; now=$$(date +%%s); last=$$(cat "$$stamp" 2>/dev/null || echo 0); [ $$((now - last)) -lt 1800 ] && exit 0; echo "$$now" > "$$stamp"; curl -s -m 20 "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" --data-urlencode chat_id="${TELEGRAM_CHAT_ID}" --data-urlencode text="{{LABEL}} v3 {{FLEET}}: the WATCHDOG is failing — the fleet is unwatched. See: journalctl --user -u grid-gremlin3-{{FLEET}}-watchdog -n 50"'
